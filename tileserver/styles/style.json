{
  "version": 8,
  "name": "UAE 3D Natural Earth Style",
  "center": [54.3892, 24.5028],
  "zoom": 15.2,
  "pitch": 65,
  "bearing": -30,
  "glyphs": "http://localhost:3000/fonts/{fontstack}/{range}.pbf",
  "light": {
    "anchor": "viewport",
    "color": "#ffffff",
    "intensity": 0.58,
    "position": [1.4, 210, 42]
  },
  "sources": {
    "uae-vector": {
      "type": "vector",
      "url": "mbtiles://{uae-vector}",
      "minzoom": 0,
      "maxzoom": 15
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#f4f0e6"
      }
    },
    {
      "id": "landuse",
      "type": "fill",
      "source": "uae-vector",
      "source-layer": "landuse",
      "paint": {
        "fill-color": "#eae2d2"
      }
    },
    {
      "id": "landcover",
      "type": "fill",
      "source": "uae-vector",
      "source-layer": "landcover",
      "paint": {
        "fill-color": "#d5e9ce",
        "fill-opacity": 0.75
      }
    },
    {
      "id": "park",
      "type": "fill",
      "source": "uae-vector",
      "source-layer": "park",
      "paint": {
        "fill-color": "#c3e5b9",
        "fill-opacity": 0.85
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "uae-vector",
      "source-layer": "water",
      "paint": {
        "fill-color": "#639ec9"
      }
    },

    {
      "id": "road-minor-casing",
      "type": "line",
      "source": "uae-vector",
      "source-layer": "transportation",
      "filter": ["match", ["get", "class"], ["minor", "service", "residential", "track"], true, false],
      "minzoom": 12,
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#cdc1b0",
        "line-width": [
          "interpolate", ["exponential", 1.5], ["zoom"],
          12, 1.5,
          15, 4.5,
          18, 10
        ]
      }
    },
    {
      "id": "road-minor",
      "type": "line",
      "source": "uae-vector",
      "source-layer": "transportation",
      "filter": ["match", ["get", "class"], ["minor", "service", "residential", "track"], true, false],
      "minzoom": 12,
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#ffffff",
        "line-width": [
          "interpolate", ["exponential", 1.5], ["zoom"],
          12, 0.8,
          15, 3,
          18, 8
        ]
      }
    },

    {
      "id": "road-primary-casing",
      "type": "line",
      "source": "uae-vector",
      "source-layer": "transportation",
      "filter": ["match", ["get", "class"], ["primary", "secondary", "tertiary"], true, false],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#bcae9b",
        "line-width": [
          "interpolate", ["exponential", 1.5], ["zoom"],
          8, 1.5,
          13, 5,
          18, 16
        ]
      }
    },
    {
      "id": "road-primary",
      "type": "line",
      "source": "uae-vector",
      "source-layer": "transportation",
      "filter": ["match", ["get", "class"], ["primary", "secondary", "tertiary"], true, false],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#ffffff",
        "line-width": [
          "interpolate", ["exponential", 1.5], ["zoom"],
          8, 0.8,
          13, 3.5,
          18, 13
        ]
      }
    },

    {
      "id": "road-highway-casing",
      "type": "line",
      "source": "uae-vector",
      "source-layer": "transportation",
      "filter": ["match", ["get", "class"], ["motorway", "trunk"], true, false],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#d98328",
        "line-width": [
          "interpolate", ["exponential", 1.5], ["zoom"],
          6, 2,
          13, 7,
          18, 20
        ]
      }
    },
    {
      "id": "road-highway",
      "type": "line",
      "source": "uae-vector",
      "source-layer": "transportation",
      "filter": ["match", ["get", "class"], ["motorway", "trunk"], true, false],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#fbbd61",
        "line-width": [
          "interpolate", ["exponential", 1.5], ["zoom"],
          6, 1,
          13, 5,
          18, 16
        ]
      }
    },

    {
      "id": "3d-buildings-extrusion",
      "type": "fill-extrusion",
      "source": "uae-vector",
      "source-layer": "building",
      "minzoom": 12,
      "maxzoom": 24,
      "paint": {
        "fill-extrusion-color": [
          "case",
          ["==", ["coalesce", ["get", "name:en"], ["get", "name"], ""], "Burj Khalifa"],
          "#4a96c9",
          [
            "interpolate",
            ["linear"],
            ["to-number", ["coalesce", ["get", "render_height"], ["get", "height"], 15], 15],
            0, "#ede8dd",
            20, "#d8dede",
            60, "#b8c9db",
            150, "#8fa7bf",
            350, "#5e7e9e",
            800, "#3e5d7d"
          ]
        ],
        "fill-extrusion-height": [
          "to-number",
          ["coalesce", ["get", "render_height"], ["get", "height"], 15],
          15
        ],
        "fill-extrusion-base": [
          "to-number",
          ["coalesce", ["get", "render_min_height"], ["get", "min_height"], 0],
          0
        ],
        "fill-extrusion-opacity": 0.95,
        "fill-extrusion-vertical-gradient": true
      }
    },

    {
      "id": "street-labels",
      "type": "symbol",
      "source": "uae-vector",
      "source-layer": "transportation_name",
      "layout": {
        "symbol-placement": "line",
        "text-field": ["coalesce", ["get", "name:en"], ["get", "name:latin"], ["get", "name"], ""],
        "text-font": ["Open Sans Regular"],
        "text-size": [
          "interpolate", ["linear"], ["zoom"],
          12, 10,
          16, 12.5
        ],
        "text-transform": "uppercase",
        "text-letter-spacing": 0.15,
        "text-max-angle": 30
      },
      "paint": {
        "text-color": "#475569",
        "text-halo-color": "#ffffff",
        "text-halo-width": 2.2
      }
    },

    {
      "id": "place-district-labels",
      "type": "symbol",
      "source": "uae-vector",
      "source-layer": "place",
      "filter": ["match", ["get", "class"], ["suburb", "neighbourhood", "island", "town", "quarter"], true, false],
      "layout": {
        "text-field": ["coalesce", ["get", "name:en"], ["get", "name:latin"], ["get", "name"], ""],
        "text-font": ["Open Sans Regular"],
        "text-size": [
          "interpolate", ["linear"], ["zoom"],
          10, 11,
          15, 14
        ],
        "text-transform": "uppercase",
        "text-letter-spacing": 0.18,
        "text-allow-overlap": false
      },
      "paint": {
        "text-color": "#334155",
        "text-halo-color": "#ffffff",
        "text-halo-width": 2.8
      }
    },

    {
      "id": "place-city-labels",
      "type": "symbol",
      "source": "uae-vector",
      "source-layer": "place",
      "filter": ["==", ["get", "class"], "city"],
      "layout": {
        "text-field": ["coalesce", ["get", "name:en"], ["get", "name:latin"], ["get", "name"], ""],
        "text-font": ["Open Sans Regular"],
        "text-size": [
          "interpolate", ["linear"], ["zoom"],
          6, 14,
          14, 20
        ],
        "text-transform": "uppercase",
        "text-letter-spacing": 0.25,
        "text-allow-overlap": true
      },
      "paint": {
        "text-color": "#0f172a",
        "text-halo-color": "#ffffff",
        "text-halo-width": 3.5,
        "text-halo-blur": 0.5
      }
    },

    {
      "id": "poi-labels",
      "type": "symbol",
      "source": "uae-vector",
      "source-layer": "poi",
      "minzoom": 13,
      "layout": {
        "text-field": ["coalesce", ["get", "name:en"], ["get", "name:latin"], ["get", "name"], ""],
        "text-font": ["Open Sans Regular"],
        "text-size": [
          "interpolate", ["linear"], ["zoom"],
          13, 9.5,
          16, 11.5
        ],
        "text-letter-spacing": 0.05
      },
      "paint": {
        "text-color": "#1e293b",
        "text-halo-color": "#ffffff",
        "text-halo-width": 2.2
      }
    }
  ]
}
