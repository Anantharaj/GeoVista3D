{
  "version": 8,
  "name": "UAE 3D Vector Style (TileServer GL)",
  "center": [54.3892, 24.5028],
  "zoom": 15.2,
  "pitch": 65,
  "bearing": -30,
  "glyphs": "http://localhost:3000/fonts/{fontstack}/{range}.pbf",
  "sources": {
    "uae-vector": {
      "type": "vector",
      "url": "mbtiles://{uae-vector}",
      "minzoom": 0,
      "maxzoom": 15
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#eef2f6"
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "uae-vector",
      "source-layer": "water",
      "paint": {
        "fill-color": "#a0cbf8"
      }
    },
    {
      "id": "landuse",
      "type": "fill",
      "source": "uae-vector",
      "source-layer": "landuse",
      "paint": {
        "fill-color": "#f5f7fa"
      }
    },
    {
      "id": "transportation",
      "type": "line",
      "source": "uae-vector",
      "source-layer": "transportation",
      "paint": {
        "line-color": "#cbd5e1",
        "line-width": 3
      }
    },
    {
      "id": "3d-buildings-extrusion",
      "type": "fill-extrusion",
      "source": "uae-vector",
      "source-layer": "building",
      "minzoom": 12,
      "maxzoom": 24,
      "paint": {
        "fill-extrusion-color": [
          "interpolate",
          ["linear"],
          ["to-number", ["coalesce", ["get", "render_height"], ["get", "height"], 15], 15],
          0, "#a0aebc",
          25, "#7b8a99",
          70, "#5a6b7c",
          150, "#3f4f60",
          300, "#253241"
        ],
        "fill-extrusion-height": [
          "to-number",
          ["coalesce", ["get", "render_height"], ["get", "height"], 15],
          15
        ],
        "fill-extrusion-base": [
          "to-number",
          ["coalesce", ["get", "render_min_height"], ["get", "min_height"], 0],
          0
        ],
        "fill-extrusion-opacity": 0.94,
        "fill-extrusion-vertical-gradient": true
      }
    },
    {
      "id": "street-labels",
      "type": "symbol",
      "source": "uae-vector",
      "source-layer": "transportation_name",
      "layout": {
        "symbol-placement": "line",
        "text-field": ["coalesce", ["get", "name:en"], ["get", "name:latin"], ["get", "name"], ""],
        "text-font": ["Open Sans Regular"],
        "text-size": 11,
        "text-transform": "uppercase",
        "text-letter-spacing": 0.1
      },
      "paint": {
        "text-color": "#475569",
        "text-halo-color": "#ffffff",
        "text-halo-width": 2
      }
    },
    {
      "id": "place-labels",
      "type": "symbol",
      "source": "uae-vector",
      "source-layer": "place",
      "layout": {
        "text-field": ["coalesce", ["get", "name:en"], ["get", "name:latin"], ["get", "name"], ""],
        "text-font": ["Open Sans Regular"],
        "text-size": 13,
        "text-transform": "uppercase"
      },
      "paint": {
        "text-color": "#1e293b",
        "text-halo-color": "#ffffff",
        "text-halo-width": 2.5
      }
    },
    {
      "id": "poi-labels",
      "type": "symbol",
      "source": "uae-vector",
      "source-layer": "poi",
      "minzoom": 13,
      "layout": {
        "text-field": ["coalesce", ["get", "name:en"], ["get", "name:latin"], ["get", "name"], ""],
        "text-font": ["Open Sans Regular"],
        "text-size": 10
      },
      "paint": {
        "text-color": "#334155",
        "text-halo-color": "#ffffff",
        "text-halo-width": 2
      }
    }
  ]
}
