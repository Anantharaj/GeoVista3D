{
  "version": 8,
  "name": "UAE 3D Natural Earth Style",
  "center": [54.3892, 24.5028],
  "zoom": 15.2,
  "pitch": 65,
  "bearing": -30,
  "glyphs": "http://localhost:3000/fonts/{fontstack}/{range}.pbf",
  "light": {
    "anchor": "viewport",
    "color": "#fffaf0",
    "intensity": 0.45,
    "position": [1.15, 210, 35]
  },
  "sources": {
    "uae-vector": {
      "type": "vector",
      "url": "mbtiles://{uae-vector}",
      "minzoom": 0,
      "maxzoom": 15
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#f6f3eb"
      }
    },
    {
      "id": "landuse",
      "type": "fill",
      "source": "uae-vector",
      "source-layer": "landuse",
      "paint": {
        "fill-color": "#ede6d8"
      }
    },
    {
      "id": "landcover",
      "type": "fill",
      "source": "uae-vector",
      "source-layer": "landcover",
      "paint": {
        "fill-color": "#d8ebd3",
        "fill-opacity": 0.7
      }
    },
    {
      "id": "park",
      "type": "fill",
      "source": "uae-vector",
      "source-layer": "park",
      "paint": {
        "fill-color": "#c7e8be",
        "fill-opacity": 0.8
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "uae-vector",
      "source-layer": "water",
      "paint": {
        "fill-color": "#6fa8dc"
      }
    },
    {
      "id": "transportation-casing",
      "type": "line",
      "source": "uae-vector",
      "source-layer": "transportation",
      "paint": {
        "line-color": "#ded5c5",
        "line-width": 4
      }
    },
    {
      "id": "transportation",
      "type": "line",
      "source": "uae-vector",
      "source-layer": "transportation",
      "paint": {
        "line-color": "#ffffff",
        "line-width": 2
      }
    },
    {
      "id": "3d-buildings-extrusion",
      "type": "fill-extrusion",
      "source": "uae-vector",
      "source-layer": "building",
      "minzoom": 12,
      "maxzoom": 24,
      "paint": {
        "fill-extrusion-color": [
          "interpolate",
          ["linear"],
          ["to-number", ["coalesce", ["get", "render_height"], ["get", "height"], 15], 15],
          0, "#eae3d5",
          25, "#d5cbbe",
          60, "#a8b5c4",
          120, "#5b7086",
          250, "#2c3b4d"
        ],
        "fill-extrusion-height": [
          "to-number",
          ["coalesce", ["get", "render_height"], ["get", "height"], 15],
          15
        ],
        "fill-extrusion-base": [
          "to-number",
          ["coalesce", ["get", "render_min_height"], ["get", "min_height"], 0],
          0
        ],
        "fill-extrusion-opacity": 0.94,
        "fill-extrusion-vertical-gradient": true
      }
    },
    {
      "id": "street-labels",
      "type": "symbol",
      "source": "uae-vector",
      "source-layer": "transportation_name",
      "layout": {
        "symbol-placement": "line",
        "text-field": ["coalesce", ["get", "name:en"], ["get", "name:latin"], ["get", "name"], ""],
        "text-font": ["Open Sans Regular"],
        "text-size": 11,
        "text-transform": "uppercase",
        "text-letter-spacing": 0.1
      },
      "paint": {
        "text-color": "#4a5568",
        "text-halo-color": "#ffffff",
        "text-halo-width": 2
      }
    },
    {
      "id": "place-labels",
      "type": "symbol",
      "source": "uae-vector",
      "source-layer": "place",
      "layout": {
        "text-field": ["coalesce", ["get", "name:en"], ["get", "name:latin"], ["get", "name"], ""],
        "text-font": ["Open Sans Regular"],
        "text-size": 13,
        "text-transform": "uppercase"
      },
      "paint": {
        "text-color": "#2d3748",
        "text-halo-color": "#ffffff",
        "text-halo-width": 2.5
      }
    },
    {
      "id": "poi-labels",
      "type": "symbol",
      "source": "uae-vector",
      "source-layer": "poi",
      "minzoom": 13,
      "layout": {
        "text-field": ["coalesce", ["get", "name:en"], ["get", "name:latin"], ["get", "name"], ""],
        "text-font": ["Open Sans Regular"],
        "text-size": 10
      },
      "paint": {
        "text-color": "#334155",
        "text-halo-color": "#ffffff",
        "text-halo-width": 2
      }
    }
  ]
}
